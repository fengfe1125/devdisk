<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>DevDisk</string>
	<key>CFBundleDisplayName</key>
	<string>DevDisk</string>
	<key>CFBundleExecutable</key>
	<string>DevDisk</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<!-- Must stay stable: macOS keys Automation permission to the bundle id, so
	     changing it makes every rebuild look like a new app and re-prompts. -->
	<key>CFBundleIdentifier</key>
	<string>com.sakura.devdisk</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Semantic version, matched by the git tag (v1.0.0) and compared against
	     the latest GitHub release by UpdateChecker. -->
	<key>CFBundleShortVersionString</key>
	<string>1.2.0</string>
	<key>CFBundleVersion</key>
	<string>13</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<!-- Required to ask Android Studio / Xcode to quit via AppleScript. Without this
	     key the Apple Event fails silently rather than prompting. -->
	<key>NSAppleEventsUsageDescription</key>
	<string>DevDisk needs to ask apps such as Android Studio and Xcode to quit so it can safely eject the external development drive. It only sends a quit request; each app handles its unsaved work.</string>
	<key>NSHumanReadableCopyright</key>
	<string></string>
</dict>
</plist>
